# frozen_string_literal: true

require "json"
require "digest"

def stable_vm_uuid(name)
  hex = Digest::SHA256.hexdigest("longhorn-test/#{name}")[0, 32]
  hex[12] = "5"
  hex[16] = ((hex[16].to_i(16) & 0x3) | 0x8).to_s(16)
  [hex[0, 8], hex[8, 4], hex[12, 4], hex[16, 4], hex[20, 12]].join("-")
end

topology_path = ENV.fetch("LONGHORN_TEST_TOPOLOGY_FILE")
run_dir = ENV.fetch("LONGHORN_TEST_RUN_DIR")
topology = JSON.parse(File.read(topology_path))
cluster = topology.fetch("cluster")
data_prefix_length = Integer(cluster.fetch("data_network").fetch("cidr").split("/").last)
token_path = File.join(run_dir, "cluster-token")
cluster_token = File.read(token_path).strip
server = topology.fetch("nodes").find { |node| node.fetch("role") == "server" }
raise "topology must have one server" unless server
windows_kubelet = cluster.fetch("windows_kubelet", {})

Vagrant.configure("2") do |config|
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.boot_timeout = 1800
  config.ssh.keep_alive = true

  topology.fetch("nodes").each do |node|
    config.vm.define node.fetch("name") do |machine|
      vm_uuid = stable_vm_uuid(node.fetch("name"))
      machine.vm.hostname = node.fetch("name")
      machine.vm.box = node.fetch("box")
      machine.vm.communicator = node.fetch("os") == "windows" ? "winrm" : "ssh"

      machine.vm.network :private_network,
        ip: node.fetch("management_ip")
      machine.vm.network :public_network,
        ip: node.fetch("data_ip"),
        dev: cluster.fetch("data_network").fetch("bridge"),
        mode: "bridge",
        type: "bridge",
        ovs: true,
        mac: node.fetch("mac"),
        libvirt__iface_name: node.fetch("tap")

      if node.fetch("os") == "windows"
        machine.winrm.retry_limit = 60
        machine.winrm.retry_delay = 10
        machine.winrm.transport = :plaintext
        machine.winrm.basic_auth_only = true
      end

      machine.vm.provider :libvirt do |libvirt|
        libvirt.qemu_use_session = false
        # Expose deterministic firmware identity and keep the libvirt domain
        # and SMBIOS UUID identical, as required by libvirt. The old-runtime
        # profile separately pins the upstream kubelet registry UUID fix
        # because Win32_ComputerSystemProduct is optional on QEMU guests.
        libvirt.uuid = vm_uuid
        libvirt.sysinfo = {
          "system" => {
            "manufacturer" => "Longhorn",
            "product" => "Longhorn test VM",
            "version" => "1",
            "serial" => node.fetch("name"),
            "uuid" => vm_uuid,
            "family" => "Longhorn integration tests"
          }
        }
        libvirt.cpus = node.fetch("cpus")
        libvirt.memory = node.fetch("memory_mb")
        libvirt.cpu_mode = "host-passthrough"
        libvirt.machine_type = "q35"
        libvirt.nic_model_type = "virtio"
        libvirt.disk_bus = "scsi"
        libvirt.driver = "kvm"
        libvirt.video_type = node.fetch("os") == "windows" ? "qxl" : "virtio"
        libvirt.input type: "tablet", bus: "usb" if node.fetch("os") == "windows"
        if node.fetch("data_disk_gb", 0).positive?
          libvirt.storage :file,
            size: "#{node.fetch('data_disk_gb')}G",
            type: "qcow2",
            bus: "scsi",
            cache: "none",
            io: "native",
            discard: "unmap",
            detect_zeroes: "unmap"
        end
      end

      labels = node.fetch("labels", {}).map { |key, value| "#{key}=#{value}" }.join(",")
      taints = node.fetch("taints", []).join(",")
      cnis = [cluster.dig("secondary_cni", "name"), cluster.fetch("cni")].compact.join(",")
      if node.fetch("os") == "windows"
        windows_args = [
          "-NodeName", node.fetch("name"),
          "-NodeIP", node.fetch("data_ip"),
          "-DataMac", node.fetch("mac"),
          "-DataPrefixLength", data_prefix_length,
          "-DataCIDR", cluster.fetch("data_network").fetch("cidr"),
          "-ServerIP", server.fetch("data_ip"),
          "-ClusterToken", cluster_token,
          "-Rke2Version", cluster.fetch("rke2_version"),
          "-Filesystem", node.fetch("filesystem")
        ]
        windows_args += ["-Labels", labels] unless labels.empty?
        windows_args += ["-Taints", taints] unless taints.empty?
        unless windows_kubelet.empty?
          windows_args += [
            "-KubeletURL", windows_kubelet.fetch("url"),
            "-KubeletSHA256", windows_kubelet.fetch("sha256"),
            "-KubeletVersion", windows_kubelet.fetch("version")
          ]
        end
        machine.vm.provision "shell",
          path: "scripts/windows-agent.ps1",
          args: windows_args,
          privileged: false,
          reboot: true
      else
        machine.vm.provision "shell",
          path: "scripts/linux-node.sh",
          args: [
            node.fetch("name"), node.fetch("role"), node.fetch("data_ip"),
            node.fetch("management_ip"), server.fetch("data_ip"), cluster_token, cluster.fetch("rke2_version"),
            cnis, node.fetch("filesystem", ""), labels, taints
          ]
      end
    end
  end
end
